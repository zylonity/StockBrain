# =============================================================================
# StockBrain configuration
#
# Copy to .env and fill in.  NEVER commit .env.
# Every value here is read by backend/stockbrain/config.py.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=local                       # local | production | test
LOG_LEVEL=INFO
LOG_FORMAT=json                     # json | console
TIMEZONE=Europe/London
HTTP_PORT=8080

# Signing key for session cookies and approval-token HMACs.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED when APP_ENV=production.
STOCKBRAIN_SECRET_KEY=

# Extra origins allowed by CORS. Only needed when running the Vite dev server
# separately from the API; the production image serves the SPA same-origin.
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- PostgreSQL --------------------------------------------------------------
# Password used by the postgres container in compose.yaml.
POSTGRES_PASSWORD=change-me-in-dot-env

# Must use the asyncpg driver. Inside compose the host is the service name.
DATABASE_URL=postgresql+asyncpg://stockbrain:change-me-in-dot-env@postgres:5432/stockbrain

# --- DeepSeek ----------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# --- Alpaca (news + market data only; never used for execution) ---------------
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_STOCK_FEED=iex               # iex | sip | delayed_sip (subscription dependent)

# --- Firecrawl ---------------------------------------------------------------
FIRECRAWL_API_KEY=

# --- SEC EDGAR (no API key; a descriptive User-Agent is mandatory) ------------
SEC_CONTACT_EMAIL=you@example.com

# --- FRED --------------------------------------------------------------------
FRED_API_KEY=

# --- Trading 212 -------------------------------------------------------------
# Create the API key in the Trading 212 app. IP-restrict it if practical.
T212_API_KEY=
T212_API_SECRET=

# demo | live. Demo maps to https://demo.trading212.com/api/v0
T212_ENV=demo

# LIVE EXECUTION GATE.
# A live order is only ever submitted when ALL FOUR of the following hold:
#   T212_ENV=live
#   T212_LIVE_EXECUTION_ENABLED=true
#   T212_WRITTEN_CONSENT_CONFIRMED=true
#   EXECUTION_MODE=manual_approval
# plus an explicit two-stage human confirmation for that specific order.
#
# Trading 212's API Terms prohibit "Algorithmic Trading" and require prior
# written consent for using a customised interface in the live environment.
# Only set T212_WRITTEN_CONSENT_CONFIRMED=true once you actually hold that
# consent. StockBrain refuses to start on a contradictory combination rather
# than silently resolving it in favour of live.
T212_LIVE_EXECUTION_ENABLED=false
T212_WRITTEN_CONSENT_CONFIRMED=false
EXECUTION_MODE=manual_approval      # manual_approval | research_only

# --- Telegram ----------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# NUMERIC ids only. Usernames are never used for authorization because they
# can be changed by their owner. Comma separated.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Subsystem toggles -------------------------------------------------------
DISCOVERY_ENABLED=true
ALPACA_NEWS_ENABLED=true
FIRECRAWL_ENABLED=true
SEC_ENABLED=true
