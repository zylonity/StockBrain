# =============================================================================
# StockBrain configuration
#
# Copy to .env and fill in.  NEVER commit .env.
# Every value here is read by backend/stockbrain/config.py.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=local                       # local | production | test
LOG_LEVEL=INFO
LOG_FORMAT=json                     # json | console

# How many recent structured log events the GUI's Logs page can show. Held in
# memory only, so the buffer starts empty after a restart and costs a known,
# constant amount of memory rather than growing. 0 switches capture off for a
# deployment that would rather read `docker compose logs`. Nothing below
# LOG_LEVEL is captured, whatever the page's filter asks for.
LOG_BUFFER_SIZE=4000

TIMEZONE=Europe/London
HTTP_PORT=8080

# Signing key for session cookies and approval-token HMACs.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED when APP_ENV=production.
STOCKBRAIN_SECRET_KEY=

# Extra origins allowed by CORS. Only needed when running the Vite dev server
# separately from the API; the production image serves the SPA same-origin.
CORS_ALLOW_ORIGINS=http://localhost:5173

# Actively test every enabled provider once at startup, so the health board
# reports this deployment rather than "nothing has happened yet". Without it a
# restarted container reads DEGRADED until unrelated work happens to exercise
# each provider -- which for the semantic discovery queries is a day.
#
# No probe makes a billable request. Brave, Exa and DeepSeek are checked for
# credential validity (a request the provider must reject), never by searching:
# EXA_MAX_SEARCHES_PER_DAY defaults to 3, so probing by searching would let a
# few restarts spend the whole semantic allowance on health checks.
#
# For genuine end-to-end proof, run the opt-in live test instead -- one real
# search per provider, on your decision rather than on every restart:
#   pytest -m live -s tests/integration/test_web_discovery_live.py
#
# Turn this off only for an offline or air-gapped start, where the outbound
# calls would simply time out.
STARTUP_PROBE_ENABLED=true

# Per-probe ceiling in seconds. Probes run concurrently, so this is close to
# the total time the sweep can add to startup.
STARTUP_PROBE_TIMEOUT_SECONDS=10

# --- PostgreSQL --------------------------------------------------------------
# Password used by the postgres container in compose.yaml.
POSTGRES_PASSWORD=change-me-in-dot-env

# Must use the asyncpg driver. Inside compose the host is the service name.
DATABASE_URL=postgresql+asyncpg://stockbrain:change-me-in-dot-env@postgres:5432/stockbrain

# --- DeepSeek (the default LLM backend) --------------------------------------
# Without a key the classifier is simply not registered: ingestion still runs and
# events wait in NEW status until one is supplied.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_ATTEMPTS=3

# --- LLM backend (any OpenAI-compatible endpoint) -----------------------------
# StockBrain talks to any endpoint that speaks POST /chat/completions with a
# bearer token. Leave this block untouched to keep DeepSeek, which is the
# default and needs nothing here.
#
# LLM_PROVIDER names a *profile* -- the API contract, not the model. Profiles:
#
#   deepseek         api.deepseek.com; thinking={"type":"disabled"}, json_object,
#                    max_tokens, prompt_cache_hit/miss_tokens, time-of-day pricing
#   meta             api.meta.ai/v1; reasoning_effort, json_schema,
#                    max_completion_tokens, prompt_tokens_details.cached_tokens
#   meta-go          OpenCode Go's Muse Spark contributor endpoint
#                    (opencode.ai/zen/go/v1); same Muse Spark contract as
#                    `meta`, but served ONLY through the Responses API --
#                    POST /chat/completions is a 503 for this model, /responses
#                    answers. Requires LLM_API_KEY (a Go key). Two endpoint
#                    rules, both observed live 2026-09-21: every call must
#                    carry `x-opencode-session` (a routing/cache-affinity
#                    header; the client sets a stable UUID, the research
#                    transport re-scopes one per run -- without it the endpoint
#                    answers "MissingSessionID"), and the workspace's privacy
#                    settings must allow endpoints that train on request data
#                    (this is the contributor tier; that is the deal). Prices
#                    are Meta's contributor card forwarded unchanged, so the
#                    same 0.10 / 0.002 / 0.20 rates below still apply.
#   openai           api.openai.com/v1; json_object, max_completion_tokens
#   generic          you supply LLM_BASE_URL; json_object, max_tokens, no cache
#                    accounting (everything bills at the uncached rate)
#   generic-no-json  as generic, but the endpoint has no JSON mode at all
#
# An unknown name is a startup error, not a fallback: a typo must not silently
# redirect every model call onto a backend with different prices.
#
# There is NO automatic failover between providers. If the configured backend
# fails, the call fails visibly. A silent switch would hide the outage, change
# the cost profile of whatever ran next, and make llm_calls ambiguous about
# which model actually produced a stored classification.
LLM_PROVIDER=deepseek

# Required for every provider except deepseek, which falls back to DEEPSEEK_*.
LLM_API_KEY=
# Required for `generic`; overrides the profile default for the others.
LLM_BASE_URL=
LLM_MODEL=
# Deep research roles. Leave empty when the provider serves one model at both
# depths -- nothing downstream requires a Flash/Pro split.
LLM_DEEP_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_ATTEMPTS=3

# Token prices in USD per 1,000,000 tokens. REQUIRED for any provider without
# built-in rates (only DeepSeek has them).
#
# This is not bookkeeping. BudgetGuard sums estimated cost from llm_calls, and
# an unpriced model estimates None rather than 0 -- so an unpriced provider is
# not merely mis-reported, it is silently exempt from LLM_DAILY_HARD_USD and
# LLM_MONTHLY_HARD_USD. Startup refuses to run without these.
#
# Leaving the cached rate unset bills cached tokens at the full input rate,
# which over-estimates. That is the safe direction: a budget that under-counts
# spends past its ceiling, and only over-counting is recoverable.
#
# To look up published rates for a model:
#   python -m stockbrain.llm.rates_cli --search <model>
#   python -m stockbrain.llm.rates_cli <exact-model-id>
# It prints these variables ready to paste. It is an authoring aid only -- the
# runtime never fetches prices, because a spend ceiling must not depend on a
# third party being reachable, current and honest.
LLM_INPUT_USD_PER_MTOK=
LLM_CACHED_INPUT_USD_PER_MTOK=
LLM_OUTPUT_USD_PER_MTOK=
# Only needed when LLM_DEEP_MODEL is a different, differently-priced model.
LLM_DEEP_INPUT_USD_PER_MTOK=
LLM_DEEP_CACHED_INPUT_USD_PER_MTOK=
LLM_DEEP_OUTPUT_USD_PER_MTOK=

# Worked example -- Meta Muse Spark 1.3 Contributor (verified 2026-09-06 against
# dev.meta.ai/docs/pricing-rate-limits and dev.meta.ai/docs/models):
#
#   LLM_PROVIDER=meta
#   LLM_API_KEY=<your Meta Model API key>
#   LLM_MODEL=muse-spark-1.3-contributor
#   LLM_INPUT_USD_PER_MTOK=0.10
#   LLM_CACHED_INPUT_USD_PER_MTOK=0.002
#   LLM_OUTPUT_USD_PER_MTOK=0.20
#
# Worked example -- the SAME model through OpenCode Go (verified live
# 2026-09-21/22 against opencode.ai/zen/go/v1). The token prices are identical
# to the direct card above; what the Go subscription buys is usage capacity,
# not a rate cut. Requires a Go key and the workspace privacy opt-in described
# in the meta-go profile entry:
#
#   LLM_PROVIDER=meta-go
#   LLM_API_KEY=<your OpenCode Go key>
#   LLM_MODEL=muse-spark-1.3-contributor
#   LLM_INPUT_USD_PER_MTOK=0.10
#   LLM_CACHED_INPUT_USD_PER_MTOK=0.002
#   LLM_OUTPUT_USD_PER_MTOK=0.20
#   # LLM_BASE_URL stays empty: the minted profile already carries
#   # https://opencode.ai/zen/go/v1, and the client appends /responses itself.
#
# !! DATA USE WARNING -- the `-contributor` tier only !!
# Meta documents the contributor tier as "heavily discounted token pricing in
# exchange for permission to use your prompts and completions to train future
# Meta models". Everything StockBrain sends the classifier -- article text,
# your symbol hints, your prompts -- and everything the model returns becomes
# Meta training data. The non-contributor `muse-spark-1.3` does not carry this
# condition and costs $1.25 / $0.15 / $4.25 per 1M tokens instead.
# Use the contributor tier only if that trade is acceptable to you.
#
# Two further differences from DeepSeek worth knowing before switching:
#   - Muse Spark CANNOT disable reasoning. `reasoning_effort: "none"` is a
#     documented 400, so the cheap high-volume classifier path always pays for
#     some reasoning tokens. StockBrain sends the documented floor, "minimal".
#   - The contributor tier is rate limited to 100 RPM (standard is 3,000).

# --- Fallback LLM (optional) -------------------------------------------------
# Used only when the primary above rate-limits us or is down after its own
# retries. Calls it answers are logged under its own provider/model and count
# against the same LLM_DAILY/MONTHLY caps. Leave LLM_FALLBACK_PROVIDER empty to
# disable. Provider must be a profile name: deepseek, meta, meta-go, openai,
# generic, generic-no-json.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_DEEP_MODEL=
LLM_FALLBACK_INPUT_USD_PER_MTOK=
LLM_FALLBACK_CACHED_INPUT_USD_PER_MTOK=
LLM_FALLBACK_OUTPUT_USD_PER_MTOK=

# --- Event classification ------------------------------------------------------
CLASSIFIER_ENABLED=true

# Thresholds that promote a classified event to CANDIDATE (worth deeper
# research). These decide only where analysis compute is spent. Model scores are
# ranking features, not calibrated probabilities, and never a trading signal.
CLASSIFIER_MIN_IMPORTANCE=0.60
CLASSIFIER_MIN_CONFIDENCE=0.65
CLASSIFIER_MIN_MATERIALITY=0.50

# Layer-4 (semantic) deduplication. Runs only after the deterministic layers and
# only against plausible candidates.
SEMANTIC_DEDUPE_ENABLED=true
# A merge must clear this confidence. Keeping two events apart is recoverable;
# silently merging two different events is not, so the bar is deliberately high.
SEMANTIC_DEDUPE_MIN_CONFIDENCE=0.70

# --- LLM budget (USD) ----------------------------------------------------------
# Telemetry-driven spend caps, estimated from recorded token counts.
#
# At the SOFT limit: optional work (semantic deduplication) is suppressed and the
# research subsystem reports DEGRADED. Essential classification continues.
#
# At the HARD limit: no new model analysis starts. Ingestion, deterministic
# deduplication, broker reconciliation and portfolio safety alerts continue
# regardless -- running out of model budget is never a reason to stop knowing
# what the broker thinks your account holds.
LLM_DAILY_SOFT_USD=2.00
LLM_DAILY_HARD_USD=5.00
LLM_MONTHLY_SOFT_USD=30.00
LLM_MONTHLY_HARD_USD=75.00

# --- Alpaca (news + market data only; never used for execution) ---------------
ALPACA_API_KEY=
ALPACA_API_SECRET=
# iex | sip | delayed_sip. Entitlement-dependent: IEX is the only feed available
# without a paid subscription, and StockBrain never assumes SIP. Alpaca also
# documents `otc`, `boats` and `overnight` feeds; none maps to an
# execution-grade price source for a US equity, so they are not offered here.
# Requesting a feed the account does not own is reported as ENTITLEMENT_MISSING
# at startup, not silently downgraded.
ALPACA_STOCK_FEED=iex

# A quote older than this may not size an order. Recorded from Phase 4;
# enforced when the risk engine lands.
MARKET_DATA_MAX_QUOTE_AGE_SECONDS=15

# Liquid US equity used for the one-request startup entitlement probe.
MARKET_DATA_PROBE_SYMBOL=AAPL

# --- Web discovery -----------------------------------------------------------
#
# READ THIS BEFORE ENABLING ANYTHING HERE.
#
# Discovery of broad thematic and second-order developments. NOT the fast-news
# path: Alpaca news and SEC EDGAR handle time-critical financial discovery and
# both are unmetered by comparison.
#
# In Phase 2 this cost real money on a schedule with nobody watching: nine
# enabled queries on 20- and 30-minute intervals, with `scrapeOptions` on every
# search, emptied a credit allowance in about an hour (29 searches, 04:59-06:01
# UTC on 2026-09-05; see firecrawl_activity_logs.csv and docs/sources.md). It
# then answered HTTP 402 for 127 consecutive jobs. Every default below is set
# against that happening again.
#
# Two providers, two purposes, two schedules:
#
#   ROUTINE  -> Brave   conventional recent-news / thematic keyword search
#   SEMANTIC -> Exa     second-order questions ("who benefits from X")
#
# There is deliberately NO automatic fallback between them. If Brave is
# unavailable, routine queries defer; they are not silently re-run on a provider
# that costs more. `Brave fails -> Exa called -> Firecrawl scrapes -> retries` is
# a cost multiplier triggered by an outage.
WEB_DISCOVERY_ENABLED=true
WEB_DISCOVERY_ROUTINE_PROVIDER=brave
WEB_DISCOVERY_SEMANTIC_PROVIDER=exa

# Cadence floors, in minutes. A topic or query row may ask for a SLOWER cadence
# but never a faster one, and the floor is applied where the interval is used --
# so a restored backup or a hand-written UPDATE cannot reintroduce the Phase 2
# cadence. Semantic is much higher because it costs more per call and answers a
# question whose answer moves over weeks.
WEB_DISCOVERY_MIN_QUERY_INTERVAL_MINUTES=360
WEB_DISCOVERY_MIN_SEMANTIC_INTERVAL_MINUTES=1440

# How long a query waits after a FAILURE before it is eligible again. Separate
# from the success interval: on a metered endpoint a retry is a second charge
# rather than a second chance, so a failing query must not be retried on the
# ordinary cadence.
WEB_DISCOVERY_FAILURE_COOLDOWN_MINUTES=120

# Default recency window for a seeded topic, in days. Provider-neutral: Brave
# spells it `pw`, Exa spells it an ISO instant, and each adapter translates.
WEB_DISCOVERY_FRESHNESS_DAYS=7

# --- Brave Search (routine discovery) ----------------------------------------
#
# https://api-dashboard.search.brave.com/  -- the "Search" plan.
#
# Pricing verified 2026-09-05: $5 per 1,000 requests, with $5 of monthly credit
# applied automatically (~1,000 requests/month at no cost). A card is required
# for identity verification even on the credit-funded tier; Brave states it will
# not be charged. Check the current terms for whether the credit carries a
# public-attribution requirement -- see docs/sources.md, which records the
# discrepancy between Brave's pricing page and third-party reporting.
#
# Unlike Firecrawl's `limit`, Brave's `count` does NOT multiply the price: one
# request is one billable request however many results come back. And Brave
# documents that only SUCCESSFUL requests are billed, which is why a bounded
# retry is permitted here and nowhere else.
BRAVE_API_KEY=

# Hard, durably-counted ceilings. The MONTHLY one is the binding constraint:
# the free credit is monthly, and 12/day for 31 days is 372. 320 requests is
# about $1.60 at the published rate -- affordable even if the credit does not
# apply.
BRAVE_MAX_SEARCHES_PER_DAY=30
BRAVE_MAX_SEARCHES_PER_MONTH=900

# `count` sent to /res/v1/web/search. Documented maximum 20, web results only --
# the news cluster comes back alongside at no extra charge.
BRAVE_RESULT_LIMIT=10

# `result_filter` values. A relevance knob, not a cost knob. One request returns
# every requested cluster, which is why the separate /res/v1/news/search
# endpoint -- a second billable request -- is not used.
BRAVE_RESULT_FILTER=web,news

# off | moderate | strict. Financial and industrial news is not what this filter
# is for, and `moderate` (the API default) drops legitimate results about
# weapons procurement and pharmaceuticals.
BRAVE_SAFESEARCH=off
BRAVE_TIMEOUT_SECONDS=20

# --- Exa (semantic second-order discovery) -----------------------------------
#
# https://exa.ai/  -- new accounts get $20 of credit, free tier adds $10/month.
#
# Not a second Brave. Brave answers "what was published about grid transformers
# this week"; Exa answers "which public companies benefit from a transformer
# shortage caused by datacentre expansion" -- a question a keyword index answers
# badly and an embedding index answers well, at 1.4x the price per call.
#
# Pricing verified 2026-09-05: $7 per 1,000 requests for up to 10 results, $1
# per 1,000 results above 10, contents $1 per 1,000 pages PER CONTENT TYPE.
EXA_API_KEY=

# Hard, durably-counted ceilings. Deliberately tiny: a semantic query asks a
# question whose answer moves over weeks. 70/month is about $0.49.
EXA_MAX_SEARCHES_PER_DAY=4
EXA_MAX_SEARCHES_PER_MONTH=100

# `numResults`. Ten is the ceiling included in the base price; every result
# above it is separately billed.
EXA_RESULT_LIMIT=10

# auto | fast | instant | deep-lite | deep | deep-reasoning.
# `auto` lets Exa pick between neural and keyword retrieval at the base price.
# The deep* modes are $12-15 per 1,000: a research tool, not a discovery sweep.
EXA_SEARCH_TYPE=auto

# Whether a semantic search may ALSO request page contents.
#
# DEFAULT FALSE, and the scheduler never turns it on. This is Exa's equivalent
# of Firecrawl's `scrapeOptions`: the field that quietly turns a metadata call
# into a per-result page fetch. Extraction happens after triage, locally, and is
# free.
EXA_FETCH_CONTENTS=false
EXA_SNIPPET_MAX_CHARS=1200
EXA_TIMEOUT_SECONDS=45

# --- Local content extraction ------------------------------------------------
#
# The default extractor and, in normal operation, the only one that runs. It
# costs nothing, which is what makes "search broadly, read selectively" stop
# being a budget question.
#
# Pages are read ONLY after the classifier has shortlisted them. Nothing is
# fetched during a search.
CONTENT_EXTRACTION_ENABLED=true

# Free, but not unbounded: a runaway sweep is a runaway outbound request rate
# against publishers who did not ask for it.
CONTENT_EXTRACT_MAX_PER_DAY=60
CONTENT_EXTRACT_TIMEOUT_SECONDS=20

# Response body ceiling, enforced WHILE STREAMING -- a Content-Length header is
# a claim, and a chunked response makes no claim at all.
CONTENT_EXTRACT_MAX_BYTES=5000000

# Below this an extraction counts as failed. A JavaScript shell, a consent wall
# and a paywall stub all return 200 with a few dozen words, and treating that as
# an article would mark the URL read while putting nothing useful in front of
# the classifier.
CONTENT_EXTRACT_MIN_CHARS=400

# An honest, contactable identity. Impersonating a browser to get past a
# publisher's block is both dishonest and fragile. Put a real contact in it.
CONTENT_EXTRACT_USER_AGENT=StockBrain/0.1 (self-hosted research agent; +https://github.com/)

# --- Firecrawl (fallback extractor ONLY) -------------------------------------
#
# Firecrawl was the primary discovery provider through Phase 9. It is not any
# more: the search path is REMOVED from the codebase. What remains is one paid
# page fetch for the case local extraction cannot handle -- a publisher that
# answers 403 to a plain client, or serves a shell that needs rendering.
#
# Billing, verified 2026-09-05 against https://docs.firecrawl.dev/billing :
#   * /v2/scrape = 1 credit per page
#   * json (+4), prompt-injection check (+4), zero-data-retention (+1) are extra
#     per page and none is requested
#   * a request its infrastructure processed is billed even if it errored, so
#     nothing here retries
FIRECRAWL_API_KEY=

# TWO switches, because "the credential exists" and "spend it on this page" are
# two decisions. Both must be true, and even then the fallback runs only for a
# shortlisted URL whose free attempt failed for a reason a different fetcher
# could plausibly fix.
FIRECRAWL_ENABLED=false
FIRECRAWL_FALLBACK_EXTRACTION_ENABLED=false

# Hard, durably-counted ceilings. The monthly one matters most: Firecrawl's
# allowance is monthly, and 10/day for 31 days is 310.
FIRECRAWL_MAX_SCRAPES_PER_DAY=5
FIRECRAWL_DAILY_CREDIT_CAP=10
FIRECRAWL_MONTHLY_CREDIT_CAP=200
FIRECRAWL_SCRAPE_TIMEOUT_SECONDS=60

# --- Foreign exchange (phase 9) ----------------------------------------------
#
# The live account is GBP and the priced universe is USD, so without a verified
# rate the risk engine blocks every proposal it can price. It blocks by design:
# an invented rate is a wrong position size, silently.
#
#   none         cross-currency sizing stays blocked (the safe default)
#   alpaca       /v1beta1/forex/latest/rates -- live bid/mid/ask, instant
#                timestamps. MEASURED 2026-09-05: HTTP 403 "insufficient
#                grants" on the plan that covers IEX equity data.
#   frankfurter  central-bank reference fixings, no key, no quota, and
#                documented by its own authors as "not for live trading".
#                Requires FX_ALLOW_REFERENCE_GRADE=true.
FX_PROVIDER=none

# Freshness limits, in seconds. Execution-grade is a live feed; reference-grade
# is a daily fixing and gets its own, longer budget. Central banks do not
# publish at weekends, so a Monday-morning fixing is dated the previous Friday
# and cross-currency sizing blocks until the next one -- when equity markets are
# closed anyway.
FX_MAX_AGE_SECONDS=900
FX_REFERENCE_MAX_AGE_SECONDS=90000

# Whether a published fixing may size a trade at all.
FX_ALLOW_REFERENCE_GRADE=false

# How far the rate may move between authorization and transmission. The
# analogue of RISK_MAX_REFERENCE_PRICE_DRIFT_PCT: on a GBP account buying USD,
# a 1% move in the pair moves the account-currency notional by 1%, straight
# through the per-trade cap and the cash reserve. Past this the proposal is
# invalidated and re-derived, never silently resized.
FX_MAX_RATE_DRIFT_PCT=0.005

FX_FRANKFURTER_BASE_URL=https://api.frankfurter.dev

# The pair used for the one-request entitlement probe. Defaults to the
# account's own pair: "forex works" is not the useful question, "this pair
# works on this plan" is.
FX_PROBE_BASE_CURRENCY=GBP
FX_PROBE_QUOTE_CURRENCY=USD

# --- SEC EDGAR (no API key; a descriptive User-Agent is mandatory) ------------
SEC_CONTACT_EMAIL=you@example.com

# --- FRED --------------------------------------------------------------------
FRED_API_KEY=

# --- Trading 212 -------------------------------------------------------------
# Create the API key in the Trading 212 app. IP-restrict it if practical.
T212_API_KEY=
T212_API_SECRET=

# demo | live. Demo maps to https://demo.trading212.com/api/v0
T212_ENV=demo

# Read-only instrument/exchange metadata sync. This is the only Trading 212
# access Phase 4 uses; no order endpoint is implemented anywhere yet.
# The endpoints are rate-limited to one request per 50s (instruments) and
# 30s (exchanges), so a six-hourly refresh is ample.
T212_METADATA_ENABLED=true
INSTRUMENT_REFRESH_INTERVAL_MINUTES=360
INSTRUMENT_STALENESS_HOURS=24

# LIVE EXECUTION GATE.
# A live order is only ever submitted when ALL FOUR of the following hold:
#   T212_ENV=live
#   T212_LIVE_EXECUTION_ENABLED=true
#   T212_WRITTEN_CONSENT_CONFIRMED=true
#   EXECUTION_MODE=manual_approval
# plus an authorization for that specific order: a human approval, or -- under
# EXECUTION_POLICY=automatic -- SYSTEM_AUTOMATIC with
# T212_AUTOMATED_TRADING_CONSENT_CONFIRMED=true (see the execution policy below).
#
# Trading 212's API Terms prohibit "Algorithmic Trading" and require prior
# written consent for using a customised interface in the live environment.
# Only set T212_WRITTEN_CONSENT_CONFIRMED=true once you actually hold that
# consent. StockBrain refuses to start on a contradictory combination rather
# than silently resolving it in favour of live.
T212_LIVE_EXECUTION_ENABLED=false
T212_WRITTEN_CONSENT_CONFIRMED=false
EXECUTION_MODE=manual_approval      # manual_approval | research_only

# How often broker cash and open positions are re-read (read-only: the account
# summary endpoint allows 1 req/5s, positions 1 req/1s).
T212_ACCOUNT_REFRESH_INTERVAL_SECONDS=60

# --- Broker order transmission (Phase 8) -------------------------------------
# The master switch for ANY order transmission, demo included. Default false so
# that deploying the execution layer does not, by itself, start sending orders.
# This is NOT one of the four live gates and never substitutes for them: with
# T212_ENV=live those still apply on top of this one.
#
# The API key also needs the `orders:execute` scope in Trading 212's own key
# settings. Without it the order endpoint answers HTTP 403 and StockBrain
# records a definitive broker rejection.
T212_EXECUTION_ENABLED=false

# Whether a market order may fill outside the regular session. Trading 212
# defaults this to false and StockBrain keeps that: the Phase 6 spread ceiling
# is calibrated on regular-hours books, and an overnight book was measured at
# 1,024 bps.
T212_ORDER_EXTENDED_HOURS=false

# Timeout for the one order POST. Longer than a GET's on purpose: a timeout here
# does not mean "try again", it means the outcome is unknown and reconciliation
# is required, so waiting a little longer for a definitive answer is strictly
# better than giving up on one.
# Trading 212 documents a functional limit of 50 pending orders per ticker per
# account, and the Phase 8 demo test proved orders really do queue: a market
# order placed while the market was closed came back HTTP 200 with status NEW.
# StockBrain refuses to use the last few slots, because the limit is enforced by
# a rejection from a NON-IDEMPOTENT endpoint and the broker's pending list can
# lag a fill.
T212_MAX_PENDING_ORDERS_PER_TICKER=50
T212_PENDING_ORDER_HEADROOM=5

T212_ORDER_TIMEOUT_SECONDS=30

# How often the scheduler enqueues execution for authorized proposals, and how
# often reconciliation sweeps unresolved attempts.
EXECUTION_ENQUEUE_INTERVAL_SECONDS=30
RECONCILE_INTERVAL_SECONDS=60

# How long after transmission an attempt must be before reconciliation may
# conclude the order was NOT placed. A negative conclusion releases the
# reservation and fails the proposal, so it has to survive the broker's own
# propagation delay: an order that exists but has not yet appeared in either the
# pending list or the history would otherwise be read as proof of absence.
EXECUTION_RECONCILE_MIN_AGE_SECONDS=60

# How far either side of the send time a broker order may be and still be
# considered a candidate match for an attempt.
EXECUTION_RECONCILE_WINDOW_SECONDS=900

# After this many inconclusive passes an attempt stops being swept and waits for
# a human. An order the broker cannot account for is not a thing to poll forever.
EXECUTION_RECONCILE_MAX_ATTEMPTS=20

# --- Telegram ----------------------------------------------------------------
# Transport is long polling (getUpdates). No inbound port, no public TLS
# endpoint and no reverse proxy are required, and none should be added: Telegram
# documents getUpdates and setWebhook as mutually exclusive, so a webhook left
# configured on the bot would silently stop polling from receiving anything.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=

# NUMERIC ids only. Usernames are never used for authorization because they can
# be changed -- and released, and re-registered by somebody else -- by their
# owner. Comma separated. An EMPTY user allowlist authorises NOBODY and the bot
# refuses to start; it is never read as "everyone".
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=

# Whether the bot may be used from a non-private chat at all. With this false,
# only a private chat with an allowlisted user is accepted, whatever the chat
# allowlist says. With it true, a non-private chat must ALSO appear in
# TELEGRAM_ALLOWED_CHAT_IDS: everyone who can read a group can read a proposal
# posted into it. A group notification carries no approval buttons, because a
# token can only be bound to one numeric user.
TELEGRAM_ALLOW_GROUP_CHATS=false

# Proposal notifications go to TELEGRAM_ALLOWED_CHAT_IDS if set, otherwise to
# each allowlisted user's own private chat. The bot never discovers a
# destination from an incoming message.
TELEGRAM_NOTIFICATIONS_ENABLED=true

# One portfolio digest a day at this UTC HH:MM: account totals, each holding's
# nearest exit floor, the open proposals and the last 24 hours of pipeline
# activity. Empty disables it. A restart after the time still sends that day's,
# because "already sent" is a notifications dedupe row rather than memory.
TELEGRAM_DAILY_SUMMARY_TIME=08:00

# getUpdates long-polling timeout. Telegram documents short polling (0) as "for
# testing purposes only".
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_POLL_INTERVAL_SECONDS=0

# How often the supervisor proves the bot can still reach Telegram, and the
# ceiling on its reconnect backoff. python-telegram-bot retries inside its own
# polling loop (1.5x, capped at 30s); this bounds the outer loop.
TELEGRAM_HEALTH_INTERVAL_SECONDS=60
TELEGRAM_MAX_BACKOFF_SECONDS=300

# Lifetime of an Approve/Reject/Details callback token, and of the stage-two
# confirmation. Both are additionally clamped to the proposal's own expiry: a
# button may never outlive the trade it refers to.
TELEGRAM_ACTION_TTL_SECONDS=900
TELEGRAM_CONFIRM_TTL_SECONDS=120

# Minimum spacing between /research calls per user (spec section 20).
TELEGRAM_RESEARCH_INTERVAL_SECONDS=30

# --- Web authentication (phase 9, spec section 19) ---------------------------
#
# "This is a personal app but it handles broker actions." Specification section
# 19 is explicit: do not expose the UI unauthenticated, secure cookies, CSRF
# protection for state-changing operations, SameSite cookies -- and "If accessed
# only over LAN/Tailscale, still require auth."
#
# Default ON. With no password hash set the process still starts and still
# serves its health probes; every protected route answers 503 naming the missing
# hash, and nothing is reachable. Generate the hash INSIDE the container so it
# is produced by the same scrypt parameters that will verify it:
#
#   docker compose exec stockbrain python -m stockbrain.hash_password
#
# The value below is a hash, never the password: the environment of a running
# container is readable by anything that can exec into it.
WEB_AUTH_ENABLED=true
WEB_OWNER_USERNAME=owner
WEB_OWNER_PASSWORD_HASH=

# Twelve hours. Long enough not to interrupt a working session, short enough
# that a forgotten open browser is not a permanent credential. Revoking every
# outstanding session means rotating STOCKBRAIN_SECRET_KEY.
WEB_SESSION_TTL_SECONDS=43200

# Leave unset for "on in production, off otherwise". A Secure cookie on an
# http:// origin is never stored, and the operator would see a login that
# silently does nothing. Set true behind a TLS-terminating reverse proxy.
# WEB_COOKIE_SECURE=true

# Only needed to run with WEB_AUTH_ENABLED=false in production -- an
# authenticating reverse proxy, a Tailscale-only listener, or an accepted risk.
# It exists so that choosing network trust is a decision somebody recorded
# rather than a password nobody set.
WEB_TRUSTED_NETWORK_ACKNOWLEDGED=false

# --- Operational alerts (phase 9) --------------------------------------------
# Uses the existing Telegram notification path. A deliberately disabled provider
# is never alerted on: an alert stream nobody reads is worse than no alerts,
# because it looks like coverage.
ALERTS_ENABLED=true
ALERT_SCAN_INTERVAL_SECONDS=300

# How long the oldest pending job may wait before it is an alert. The slowest
# legitimate step is a research run at up to ten minutes.
ALERT_QUEUE_BACKLOG_SECONDS=1800

# --- Subsystem toggles -------------------------------------------------------
DISCOVERY_ENABLED=true
ALPACA_NEWS_ENABLED=true
ALPACA_MARKET_DATA_ENABLED=true
SEC_ENABLED=true
# WEB_DISCOVERY_ENABLED, FIRECRAWL_ENABLED and the provider caps live with the
# rest of the discovery budget above: each switch and the money it commits
# belong beside each other.

# --- Disclosure feeds (keyless, non-US) --------------------------------------
# All default off.  Staged rollout: deploy with everything off, enable
# Investegate first, watch `sources` and provider health for a day, then the
# rest.  Test-time recipe: TELEGRAM_ENABLED=false, EXECUTION_MODE=research_only,
# T212_ENV=demo.
DISCLOSURE_FEEDS_ENABLED=false
# Contact placed in the shared User-Agent; blank falls back to SEC_CONTACT_EMAIL.
DISCLOSURE_FEED_USER_AGENT_CONTACT=
DISCLOSURE_FEED_TIMEOUT_SECONDS=20

# LSE/AIM regulatory news (Investegate front page): ~300-500 RNS/weekday, about
# 40% boilerplate that is filtered before ingest.
INVESTEGATE_ENABLED=false
INVESTEGATE_INTERVAL_SECONDS=300
INVESTEGATE_MAX_PAGES=3

# Xetra/Gettex/Vienna/SIX issuers that distribute through EQS: ~30-60/day.
EQS_ENABLED=false
EQS_INTERVAL_SECONDS=300

# Madrid.  Inside information (IP) is ~10-30/day; other relevant information
# (OIR) is ~50-100/day.  An empty IP feed is valid; an empty OIR feed is not.
CNMV_ENABLED=false
CNMV_INTERVAL_SECONDS=600

# Euronext FR/NL/BE/PT and Canada issuer wire: 20-80 releases per country/day.
GLOBENEWSWIRE_ENABLED=false
GLOBENEWSWIRE_COUNTRIES=France,Netherlands,Belgium,Portugal,Spain,Canada
GLOBENEWSWIRE_INTERVAL_SECONDS=900

# French issuers, English feed: ~10-20/day.
ACTUSNEWS_ENABLED=false
ACTUSNEWS_INTERVAL_SECONDS=900

# Advisory research (Phase 5); uses the existing DeepSeek key and LLM budgets.
RESEARCH_ENABLED=true
RESEARCH_TIMEOUT_SECONDS=600
RESEARCH_MAX_OUTPUT_TOKENS=3000
# reasoning_effort for the thinking roles (bull, bear, manager, trader) on a
# provider that has the knob (Meta's Muse Spark). Unspecified, the model chose
# its own and the slowest calls ran into LLM_TIMEOUT_SECONDS; low reached the
# same verdicts on stored packets in under half the time. minimal|low|medium|high.
# DeepSeek ignores this and uses its thinking switch.
RESEARCH_DEEP_REASONING_EFFORT=low
# How much of each evidence document the analysts actually see. This was pinned
# at 1600 -- a headline and a lead paragraph -- which is why every thesis came
# back HOLD or NO_ACTION: the analysts are told never to invent a figure, and
# the figures were past the cut. Ceiling is 20000, the packet's own field limit.
# Research throttling. One company is researched at most once per cooldown
# window unless the story's importance reaches the bypass; market-wide event
# types are never researched per company; the backlog sweep ignores old news.
# Per-impact materiality floor, and the most companies researched per story
# (highest materiality first). A market round-up names dozens of tickers in
# passing; each would otherwise be a full research debate. 0 disables the cap.
RESEARCH_MIN_IMPACT_MATERIALITY=0.25
RESEARCH_MAX_IMPACTS_PER_EVENT=8
RESEARCH_COMPANY_COOLDOWN_HOURS=6
RESEARCH_COOLDOWN_BYPASS_IMPORTANCE=0.85
RESEARCH_SKIP_EVENT_TYPES=MACRO,MARKET_ROUNDUP,MARKET_SUMMARY
RESEARCH_MAX_EVENT_AGE_HOURS=24
RESEARCH_EVIDENCE_CHARS=12000
# Attach SEC XBRL company facts (revenue, net income, assets, cash flow) to the
# packet. Free and keyless -- it reuses SEC_CONTACT_EMAIL and the EDGAR rate
# budget above. Covers US filers and XBRL-filing foreign issuers; anything else
# degrades explicitly rather than silently.
RESEARCH_FUNDAMENTALS_ENABLED=true
# How many times the bull and bear each speak before the manager decides. One --
# upstream's default, and what shipped until now -- means the bull opens without
# having seen the bear, and the bear replies holding the bull's whole argument
# and then closes. Across 150 runs the bear argued from absent evidence 148
# times and no manager ever recommended a direction. Two gives the bull its
# reply. Each round costs one more call from each of the two deep-model roles.
RESEARCH_DEBATE_ROUNDS=2

# --- Expectations: what others expect and are doing ---------------------------
# Analyst ratings and their direction of travel, insider Form 4 activity, and the
# estimate-vs-actual record. Free tier; the only free source measured with
# complete coverage of foreign listings (ASML, VWAGY). Without a key this
# provider is not constructed and research degrades that datum alone.
# Get one at https://finnhub.io/register
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_ENABLED=true

# Crowd-implied probabilities for the rate path, inflation and recession.
# Keyless. Macro ONLY, deliberately: single-stock prediction markets exist and
# are excluded, because a market on where a security closes is the crowd
# forecasting the very thing a research run exists to forecast -- importing it
# drags the thesis toward consensus exactly where an edge must depart from it.
POLYMARKET_ENABLED=true
POLYMARKET_BASE_URL=https://gamma-api.polymarket.com

# Consensus price targets and forward EPS via yfinance. Unofficial: it rides
# Yahoo's undocumented endpoints with no key, no SLA and no stability promise,
# and it breaks whenever Yahoo reshapes a payload. It is here because it is the
# only free source of price targets covering the foreign listings every other
# free feed refuses, and it is built to be the provider that fails -- nothing
# downstream depends on it. Switch off if the noise is not worth it.
YFINANCE_TARGETS_ENABLED=true

# --- Execution policy (phase 6) ----------------------------------------------
# Who authorizes a proposal. This is a *different* axis from EXECUTION_MODE:
# EXECUTION_POLICY gates authorization, EXECUTION_MODE and the live gates above
# gate transmission to the broker.
#
#   manual     a person authorizes every proposal in the GUI
#   automatic  the system authorizes proposals that clear every deterministic
#              rule, recording SYSTEM_AUTOMATIC provenance
#
# Demo (paper) trading is the supported path for exercising automatic mode.
EXECUTION_POLICY=manual
# Under EXECUTION_POLICY=automatic, also authorize exits (stop-loss, trailing
# stop, time exit, rotation sale) without a human. false: every exit is sent
# for manual approval and lapses at RISK_PROPOSAL_TTL_MINUTES if unanswered.
EXECUTION_AUTO_AUTHORIZE_EXITS=false
PROPOSALS_ENABLED=true

# Trading 212's API Terms clause 4.2(a) prohibit "Algorithmic Trading" -- a
# computer determining order parameters with limited or no human intervention --
# and clauses 6.6/6.7 require prior written consent for an automated customised
# interface. EXECUTION_POLICY=automatic against T212_ENV=live is exactly that,
# so it requires this flag and the process refuses to start without it. The flag
# records a fact about your relationship with your broker; it is not a bypass.
T212_AUTOMATED_TRADING_CONSENT_CONFIRMED=false

# --- Deterministic risk limits (phase 6) -------------------------------------
# These are limits, not investment recommendations. Every one of them is
# hashed into a risk policy version that is persisted with each proposal, so a
# decision stays auditable after the limits change.

# Instruments and sessions StockBrain will price and size.
RISK_ALLOWED_INSTRUMENT_TYPES=STOCK,ETF
RISK_ALLOWED_SESSIONS=REGULAR
RISK_REQUIRE_KNOWN_SESSION=true

# The hard bid/ask ceiling, in basis points of the mid. A live overnight IEX
# book showed a $33 spread on a $321 AAPL mid -- 1024 bps, a 10% round trip.
# `block` refuses a book wider than the ceiling; `reduce` sizes down instead.
# A crossed, locked, one-sided or absent book blocks under either policy.
RISK_MAX_SPREAD_BPS=50
RISK_SPREAD_POLICY=block
RISK_WIDE_SPREAD_SIZE_FACTOR=0.5

# Broker account state older than this may not size anything. Fail closed:
# there is no fallback to the last known balance.
RISK_MAX_ACCOUNT_STATE_AGE_SECONDS=300
# true: only trade listings priced in the account currency. false: allow
# cross-currency trades (e.g. a GBP account buying USD listings), sized through
# FX_PROVIDER -- which must then be configured, or startup refuses.
RISK_REQUIRE_SAME_CURRENCY=true

# Trade and portfolio caps. The engine takes the minimum of every one of them.
# RISK_MAX_TRADE_PCT applies only under RISK_SIZING_MODE=cap; conviction sizing
# replaces it with the conviction target below. RISK_MAX_AGGREGATE_EXPOSURE_PCT=1
# with RISK_MIN_CASH_RESERVE_PCT=0 lets the whole account be invested.
RISK_MAX_NOTIONAL_PER_TRADE=500
RISK_MAX_TRADE_PCT=0.02
RISK_MAX_POSITION_PCT=0.03
RISK_MAX_AGGREGATE_EXPOSURE_PCT=0.60
RISK_MIN_CASH_RESERVE_PCT=0.10
RISK_MIN_TRADE_NOTIONAL=20

# Sizing mode. `cap` (default): each buy is the smallest cap times a confidence
# factor. `conviction`: each buy tops the holding up to
#   total account value / RISK_TARGET_POSITIONS * weight(confidence)
# where weight runs from RISK_CONVICTION_MIN_WEIGHT at the confidence floor to
# RISK_CONVICTION_MAX_WEIGHT at RISK_CONVICTION_FULL_CONFIDENCE. A buy that can
# only be funded below RISK_MIN_FILL_FRACTION of its target is blocked as a
# capacity block, which lets PORTFOLIO_ROTATION_* sell a weaker holding for it.
RISK_SIZING_MODE=cap
# 0 = self-adjusting: each holding's target is its conviction weight's share of
# the whole account across everything held, capped at RISK_MAX_POSITION_PCT.
# Any other number fixes the equal-share count. /rebalance uses the same targets.
RISK_TARGET_POSITIONS=8
RISK_CONVICTION_FULL_CONFIDENCE=0.90
RISK_CONVICTION_MIN_WEIGHT=0.75
RISK_CONVICTION_MAX_WEIGHT=2.0
RISK_MIN_FILL_FRACTION=0.5

# Trading 212 documents no minimum quantity and no step size (measured: present
# on 0 of 17,452 live instruments), so whole shares rounded *down* are the
# conservative default. Rounding down can never breach a cap.
RISK_ALLOW_FRACTIONAL_QUANTITY=false
# Decimal places allowed on an order quantity when the broker has not yet told us this
# instrument's precision (Trading 212 reveals it only by rejecting: "invalid quantity
# precision N"; the value is then learned and stored per instrument).
RISK_DEFAULT_QUANTITY_PRECISION=2

# Live proposals reserve their notional, so two of them cannot each assume the
# same cash headroom.
RISK_MAX_ACTIVE_PROPOSALS=5
RISK_MAX_ACTIVE_PROPOSAL_EXPOSURE_PCT=0.10
RISK_PROPOSAL_TTL_MINUTES=30
# A thesis refused only by market state is re-evaluated at each open, no more
# often than the TTL above, until it is this old -- then the refusal is final.
# The default outlives a weekend, so a Friday-evening thesis reaches Monday.
PROPOSAL_DEFERRAL_MAX_HOURS=72
RISK_MAX_REFERENCE_PRICE_DRIFT_PCT=0.01
# The same limit for exits (SELL). Wider: an exit should not be cancelled for
# a few percent of movement while the position it closes keeps losing.
RISK_MAX_EXIT_PRICE_DRIFT_PCT=0.05
PROPOSAL_REVALIDATION_BATCH=5

# Research confidence is a ranking feature, not a calibrated probability. Below
# the floor nothing is proposed. Under RISK_SIZING_MODE=cap, confidence may only
# *shrink* a size inside the hard caps (the two settings after the floor); under
# conviction sizing it sets the target weight instead and those two are unused.
# It never lifts a cap or a block in either mode.
RISK_MIN_RESEARCH_CONFIDENCE=0.70
RISK_CONFIDENCE_MODULATES_SIZE=true
RISK_MIN_CONFIDENCE_SIZE_FACTOR=0.5
# Thesis-memory calibration. Once a (event type × action) bucket has this many
# graded outcomes, a hit rate below 50% scales the size by 0.5 + hit_rate, never
# below the floor. Dormant until the memory tables have data; only ever reduces.
RISK_CALIBRATION_MODULATES_SIZE=true
RISK_CALIBRATION_MIN_SAMPLES=10
RISK_MIN_CALIBRATION_SIZE_FACTOR=0.5
# REDUCE is a deterministic partial exit, not a liquidation. /rebalance trims
# to its computed target instead of this fraction.
RISK_REDUCE_FRACTION=0.5

# Optional confidence-based portfolio rotation. When a new BUY thesis clears
# the candidate floor but portfolio capacity blocks it (including a conviction
# buy the cash cannot fund to RISK_MIN_FILL_FRACTION), StockBrain re-runs
# research on the weakest-confidence managed holding. It only proposes selling
# after that fresh review still trails the candidate by the advantage margin
# (a confidence difference, e.g. 0.08 -- keep it small). The SELL and later BUY
# use the ordinary proposal/risk/execution paths.
PORTFOLIO_ROTATION_ENABLED=false
PORTFOLIO_ROTATION_MIN_CANDIDATE_CONFIDENCE=0.85
PORTFOLIO_ROTATION_MIN_CONFIDENCE_ADVANTAGE=0.10
PORTFOLIO_ROTATION_INTERVAL_SECONDS=300

# Deterministic exits for open positions. The sweep ships disabled and only ever
# proposes; approval follows EXECUTION_AUTO_AUTHORIZE_EXITS. A position is also
# exited when its latest research says REDUCE or SELL; a newer BUY or HOLD keeps it.
# The hard stop is the one number here whose job is to be hit: a floor, never
# widened.
RISK_EXIT_HARD_STOP_PCT=0.08
# Trailing only arms after a real gain, so an ordinary wobble after entry does
# not close a position that never went anywhere. The distance must sit below the
# arm threshold, or the floor would already be under the entry price when it
# armed.
RISK_EXIT_TRAILING_ARM_PCT=0.10
RISK_EXIT_TRAILING_PCT=0.05
# Broker snapshots a peak must be built from before the trailing rule trusts it.
# One observation is an entry price wearing a peak's name.
RISK_EXIT_MIN_PEAK_OBSERVATIONS=3
# The sweep interval is the real resolution of every price-based rule, so a fast
# move can travel through a floor between two ticks. Raise it to react slower,
# not to widen a threshold.
EXIT_SWEEP_ENABLED=false
EXIT_SWEEP_INTERVAL_SECONDS=300
# Volatility-scaled exits on top of the sweep above. The floor sits
# RISK_EXIT_ATR_MULTIPLIER ATRs below the peak, so a quiet name is stopped tight
# and a wild one is given room; the flat hard stop remains the backstop.
RISK_EXIT_ATR_MULTIPLIER=3
RISK_EXIT_ATR_PERIOD=14
# An ATR whose last bar is older than this is not trusted: the rule skips and the
# hard stop stands. Three days spans a weekend.
RISK_EXIT_ATR_MAX_AGE_DAYS=3
# Yahoo daily bars, one request per open position per day, never on the sweep's
# tick. Off by default; with no stored ATR the volatility stop cannot fire.
VOLATILITY_REFRESH_ENABLED=false
VOLATILITY_REFRESH_INTERVAL_SECONDS=21600
VOLATILITY_BARS_DAYS=90
# Thesis memory. The grading sweep records every executed thesis-backed trade and
# grades it against the benchmark from Yahoo daily closes at horizon-relative
# checkpoints (5/20/60 trading days) and on close. Zero LLM calls; writes only
# the thesis_outcomes tables. Safe to leave on.
MEMORY_GRADE_ENABLED=true
# The memory section in research packets (standing thesis, live position,
# calibration record). This changes what research sees and is the one switch
# here that affects trading. Off by default; turn on once the grades have data.
MEMORY_PACKET_ENABLED=false
MEMORY_GRADE_INTERVAL_SECONDS=21600
MEMORY_BENCHMARK_SYMBOL=SPY
MEMORY_STANDING_THESIS_MAX_AGE_DAYS=14
